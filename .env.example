# Copy to .env and fill in. .env is gitignored — never commit real keys.

# Alpaca PAPER account (https://app.alpaca.markets/ -> Paper). Used for both
# historical bars and the MCP order path. No live key is ever used.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# OpenAI — strategy generation (gpt-4o-mini).
OPENAI_API_KEY=

# Optional -----------------------------------------------------------------
# SQLite file location. Default: bars_cache.db. On the Render free tier: /tmp/trading.db
# DB_PATH=

# Truthy => no orders are submitted (the rest of the pipeline still runs).
# DRY_RUN=

# Truthy => every order is blocked with a logged reason.
# KILL_SWITCH=

# Rate limit for POST /api/cycle, seconds (default 60).
# CYCLE_MIN_INTERVAL_S=

# --- Autonomous scheduler (T5.3) ----------------------------------------------
# Truthy => a background thread runs cycles + an option-position exit sweep
# during US market hours. Unset locally so `uvicorn api:app` never spawns it.
# SCHEDULER_ENABLED=
# SCHEDULER_TICK_S=600               # seconds between ticks (exit sweep cadence)
# SCHEDULER_ENTRY_INTERVAL_MIN=180   # minimum minutes between full entry cycles
# SCHEDULER_CYCLE_N=4                # candidates per entry cycle

# Truthy => api._bootstrap_db does NOT copy seed.db onto DB_PATH (start empty;
# the scheduler reconciles order/position state from Alpaca on startup).
# SKIP_SEED_BOOTSTRAP=

# --- Gate thresholds (defaults are the strict values in gate.py) -------------
# GATE_MIN_TRADES=3                  # loosened for the hackathon's 4-day window (D50)
# GATE_MIN_TOTAL_RETURN_PCT=
# GATE_MAX_DRAWDOWN_PCT=

# --- Risk caps (defaults are the strict values in risk.py) -------------------
# Widened for the competition window only (D53); the strict defaults (3 / $2,500)
# stay in risk.py for the seed lineage and the tests. Kill switch, the $2,000
# notional ceiling and MAX_OPTION_CONTRACTS_PER_POSITION are never env-touched.
# RISK_MAX_CONCURRENT_POSITIONS=8        # strategies holding a live position at once
# RISK_MAX_OPTION_PREMIUM_AT_RISK=8000   # $ summed over open long-option positions
